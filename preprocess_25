def _print_variant_dist(variants):
    counts = {}
    for v in variants:
        counts[str(v)] = counts.get(str(v), 0) + 1
    print(f"  변형별 분포:")
    for v, c in sorted(counts.items()):
        print(f"    {v:>10}: {c:>6}개")


def _run_full(output_subdir: Path, gdrive_subdir: Path):
    """전체 스캔 경로 (base 없음)."""
    print(f"\n[1] 데이터 로드 중 (전체 스캔)...")
    layouts, s_params_ri, frequencies, file_ids, variants = collect_all_data()

    if layouts is None:
        print("\n[ERROR] 처리할 데이터가 없습니다.")
        return False

    duplicate_sets = count_duplicate_sets(SOURCE_DIR)

    print(f"\n[2] 데이터 요약")
    if duplicate_sets:
        print(f"  총 샘플 수: {len(layouts):,}개 (중복 제외 {duplicate_sets:,}개)")
    else:
        print(f"  총 샘플 수: {len(layouts):,}개")
    print(f"  레이아웃 shape: {layouts.shape}")
    print(f"  S파라미터 shape: {s_params_ri.shape}")
    print(f"  주파수 포인트: {len(frequencies)}")
    print(f"  주파수 범위: {frequencies[0]:.4f} ~ {frequencies[-1]:.4f} GHz")

    eps = 1e-10
    s11_mag = np.sqrt(s_params_ri[:,:,0]**2 + s_params_ri[:,:,1]**2)
    s21_mag = np.sqrt(s_params_ri[:,:,4]**2 + s_params_ri[:,:,5]**2)
    print(f"\n[3] S파라미터 통계 (dB)")
    print(f"  S11: {20*np.log10(s11_mag.min()+eps):.2f} ~ {20*np.log10(s11_mag.max()+eps):.2f} dB")
    print(f"  S21: {20*np.log10(s21_mag.min()+eps):.2f} ~ {20*np.log10(s21_mag.max()+eps):.2f} dB")

    print()
    _print_variant_dist(variants)

    print(f"\n[4] 저장 중...")
    save_data(output_subdir, layouts, s_params_ri, frequencies, file_ids, variants,
              gdrive_output_dir=gdrive_subdir)
    return True


def _run_incremental(base_dir: Path, output_subdir: Path, gdrive_subdir: Path):
    """증분 경로 (base 활용)."""
    print(f"\n[1] Base 로드 중: {base_dir}")
    base = load_base_preprocess(base_dir)
    base_count = len(base['file_ids'])
    print(f"  Base 샘플 수: {base_count:,}개")
    print(f"  Base 주파수 포인트: {len(base['frequencies'])}")

    print(f"\n[2] 소스 디렉터리 스캔 중...")
    current = enumerate_source_pairs(SOURCE_DIR)
    print(f"  현재 소스 샘플 수: {len(current):,}개")

    old_ids = set(base['file_ids'].tolist())
    current_ids = set(current.keys())
    to_keep = old_ids & current_ids
    to_remove = old_ids - current_ids
    to_add = current_ids - old_ids

    print(f"\n[3] Diff 결과")
    print(f"  유지(base ∩ source): {len(to_keep):,}개")
    print(f"  제거(base only):     {len(to_remove):,}개")
    print(f"  신규(source only):   {len(to_add):,}개")

    # base 필터링 (제거 대상 drop)
    if to_remove:
        keep_mask = np.array([fid in to_keep for fid in base['file_ids']], dtype=bool)
    else:
        keep_mask = np.ones(base_count, dtype=bool)

    kept_layouts = base['layouts'][keep_mask]
    kept_file_ids = base['file_ids'][keep_mask]
    kept_variants = base['variants'][keep_mask]
    kept_ri = {k: v[keep_mask] for k, v in base['ri'].items()}
    frequencies = base['frequencies']

    # 신규 파싱
    if to_add:
        print(f"\n[4] 신규 파싱 중 ({len(to_add):,}개)...")
        new_subset = {fid: current[fid] for fid in to_add}
        new_layouts, new_s_ri, _new_freqs, new_file_ids, new_variants = parse_new_files(
            new_subset, reference_frequencies=frequencies
        )
        if new_layouts is None or len(new_file_ids) == 0:
            print("  [WARNING] 신규 파싱 결과 0개")
            final_layouts = kept_layouts
            final_file_ids = list(kept_file_ids)
            final_variants = list(kept_variants)
            final_ri = kept_ri
        else:
            new_ri = split_ri(new_s_ri)
            final_layouts = np.concatenate([kept_layouts, new_layouts], axis=0) \
                if len(kept_layouts) else new_layouts
            final_file_ids = list(kept_file_ids) + list(new_file_ids)
            final_variants = list(kept_variants) + list(new_variants)
            final_ri = {
                k: (np.concatenate([kept_ri[k], new_ri[k]], axis=0)
                    if len(kept_ri[k]) else new_ri[k])
                for k in RI_KEYS
            }
    else:
        print(f"\n[4] 신규 데이터 없음 - base 필터링만 적용")
        final_layouts = kept_layouts
        final_file_ids = list(kept_file_ids)
        final_variants = list(kept_variants)
        final_ri = kept_ri

    print(f"\n[5] 최종 통계")
    duplicate_sets = count_duplicate_sets(SOURCE_DIR)
    if duplicate_sets:
        print(f"  총 샘플 수: {len(final_file_ids):,}개 (중복 제외 {duplicate_sets:,}개)")
    else:
        print(f"  총 샘플 수: {len(final_file_ids):,}개")
    print(f"  레이아웃 shape: {final_layouts.shape}")
    print(f"  주파수 포인트: {len(frequencies)}")
    print(f"  주파수 범위: {frequencies[0]:.4f} ~ {frequencies[-1]:.4f} GHz")
    print()
    _print_variant_dist(final_variants)

    print(f"\n[6] 저장 중...")
    _write_outputs(output_subdir, final_layouts, final_ri, frequencies,
                   final_file_ids, final_variants,
                   gdrive_output_dir=gdrive_subdir)
    return True


def main():
    start_time = datetime.now()
    output_dir = LOCAL_OUTPUT_DIR

    base_dir, local_next = find_base_and_next_counter(output_dir)
    # GDrive 측 기존 preprocess_N도 확인해 더 큰 번호를 채택 (덮어쓰기 방지)
    _, gdrive_next = find_base_and_next_counter(GDRIVE_OUTPUT_DIR)
    counter = max(local_next, gdrive_next)
    output_subdir = output_dir / f"preprocess_{counter}"
    gdrive_subdir = GDRIVE_OUTPUT_DIR / f"preprocess_{counter}"

    print("=" * 60)
    print("  Renewal 25x25 RF Filter 전처리")
    print("=" * 60)
    print(f"\n[설정]")
    print(f"  시작 시간: {start_time.strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"  증강 포함: True")
    print(f"  소스: {SOURCE_DIR}")
    print(f"  로컬 출력: {output_subdir}")
    print(f"  GDrive 출력: {gdrive_subdir}")
    if base_dir is not None:
        print(f"  Base (증분 모드): {base_dir}")
    else:
        print(f"  Base 없음 → 전체 스캔 모드")

    if base_dir is None:
        ok = _run_full(output_subdir, gdrive_subdir)
    else:
        ok = _run_incremental(base_dir, output_subdir, gdrive_subdir)

    if not ok:
        return

    # 저장·업로드 성공 후: 로컬/GDrive 모두 최신 KEEP_RECENT개만 남기고 정리
    prune_old_preprocess(output_dir)
    prune_old_preprocess(GDRIVE_OUTPUT_DIR)

    end_time = datetime.now()
    elapsed = end_time - start_time
    minutes, seconds = divmod(int(elapsed.total_seconds()), 60)

    print(f"\n{'=' * 60}")
    print(f"  전처리 완료!")
    print(f"  시작: {start_time.strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"  완료: {end_time.strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"  소요: {minutes}분 {seconds}초")
    print(f"  로컬 출력: {output_subdir}")
    print(f"  GDrive 출력: {gdrive_subdir}")
    print(f"{'=' * 60}")


if __name__ == "__main__":
    main()
