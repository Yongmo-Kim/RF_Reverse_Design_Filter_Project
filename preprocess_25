def split_ri(s_params_ri: np.ndarray) -> Dict[str, np.ndarray]:
    """(N, F, 8) RI 형식 → {key: (N, F)} real/imag dict (8개 키)"""
    return {
        's11_real': s_params_ri[:, :, 0],
        's12_real': s_params_ri[:, :, 2],
        's21_real': s_params_ri[:, :, 4],
        's22_real': s_params_ri[:, :, 6],
        's11_imag': s_params_ri[:, :, 1],
        's12_imag': s_params_ri[:, :, 3],
        's21_imag': s_params_ri[:, :, 5],
        's22_imag': s_params_ri[:, :, 7],
    }


def _write_outputs(output_dir: Path, layouts, ri: Dict[str, np.ndarray],
                   frequencies, file_ids, variants,
                   gdrive_output_dir: Optional[Path] = None):
    """실제 디스크 기록 (RI 형식 입력). save_data와 incremental 양쪽이 공유."""
    output_dir.mkdir(parents=True, exist_ok=True)

    np.savez_compressed(
        output_dir / 'layouts.npz',
        layouts=layouts,
        file_ids=np.array(file_ids),
        variants=np.array(variants),
    )

    np.savez_compressed(
        output_dir / 's_params.npz',
        frequencies=frequencies,
        **{k: ri[k] for k in RI_KEYS},
    )

    # 파일 크기 출력
    total_size = 0
    for f in [output_dir / 'layouts.npz', output_dir / 's_params.npz']:
        size_mb = f.stat().st_size / (1024 * 1024)
        total_size += size_mb
        print(f"    {f.name:25s} {size_mb:>8.1f} MB")
    print(f"    {'TOTAL':25s} {total_size:>8.1f} MB")

    if gdrive_output_dir is not None:
        try:
            gdrive_output_dir.mkdir(parents=True, exist_ok=True)
            for fname in ['layouts.npz', 's_params.npz']:
                shutil.copy2(str(output_dir / fname), str(gdrive_output_dir / fname))
            print(f"\n    [Upload] Google Drive 업로드 완료: {gdrive_output_dir}")
        except Exception as e:
            print(f"\n    [WARNING] Google Drive 업로드 실패: {e}")
            print(f"    → 로컬 저장은 정상 완료됨")


def save_data(output_dir: Path, layouts, s_params_ri, frequencies, file_ids, variants,
              gdrive_output_dir: Optional[Path] = None):
    """RI 형식 입력 → 8개 키로 분리 후 저장 (전체 스캔/seed_range 호환용)."""
    ri = split_ri(s_params_ri)
    _write_outputs(output_dir, layouts, ri, frequencies, file_ids, variants,
                   gdrive_output_dir)


